# Backend application and browser-origin settings.
APP_NAME=ClimateGuard AI
ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

# Local SQLite, cache and provider request settings.
DATA_DIR=
OPS_DB=
MANDI_CACHE=
CACHE_TTL=3600
HTTP_TIMEOUT=20
ADVISE_TIMEOUT=80
HTTP_USER_AGENT=KavachHackathon/1.0
MANDI_RESOURCE_ID=

# Optional external service credentials. Leave blank when not configured.
MANDI_API_KEY=
GNANI_API_KEY=
SARVAM_API_KEY=

# Gemini remains primary by default; set LLM_API_KEY to the primary provider key.
LLM_PROVIDER=GEMINI
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60
LLM_WRITE_TIMEOUT=10
LLM_POOL_TIMEOUT=5

# Optional failover providers and model overrides.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Relief routing and supplier endpoint restrictions.
OSRM_URL=https://router.project-osrm.org
RELIEF_AUTOPILOT_MINUTES=0
RELIEF_MIN_LEVEL=high
ALLOWED_SUPPLIER_HOSTS=

# Optional HTTP protections. TRUST_PROXY=1 only behind a trusted reverse proxy.
ADMIN_TOKEN=
RATE_LIMIT_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=20
TRUST_PROXY=0
MAX_REQUEST_BODY_BYTES=1048576
