APP_NAME=ClimateGuard AI
ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CACHE_TTL=3600
HTTP_TIMEOUT=20
ADVISE_TIMEOUT=80
MANDI_API_KEY=
GNANI_API_KEY=
SARVAM_API_KEY=
LLM_PROVIDER=GEMINI
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60
LLM_WRITE_TIMEOUT=10
LLM_POOL_TIMEOUT=5
# Optional backups, used automatically when the primary LLM returns 429/5xx. Any one is enough.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
